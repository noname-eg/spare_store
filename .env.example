# =============================================
# ENVIRONMENT VARIABLES (server-only unless noted)
# =============================================
# Copy this file to `.env` and fill real values.
# `.env` is git-ignored and must never be committed.

# --- SERVER ONLY (never expose in VITE_*, never return via API) ---
# Supabase project URL.
SUPABASE_URL=https://<project>.supabase.co
# Service-role key. The server REQUIRES this for privileged operations
# and intentionally refuses to fall back to the anon key.
SUPABASE_SERVICE_ROLE_KEY=

# Allowed browser origins for the API (comma-separated). With credentials,
# "*" is never used. In production this MUST be set to your public domain,
# e.g. APP_ORIGIN=https://www.yourstore.com
# Production: https://www.nonameeg.com  |  Local dev: http://localhost:8080
APP_ORIGIN=https://www.nonameeg.com

# --- PUBLIC / SAFE FOR BROWSER ---
# None required: the storefront uses SUPABASE_ANON_KEY only if a future
# client-side Supabase SDK is added — never the service role.
# Do NOT create VITE_ variables for secrets.

NODE_ENV=production
# Server port (production runtime).
PORT=3000